{
  "expo": {
    "name": "Küü",
    "slug": "kuu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kuu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kuu.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Küü uses the microphone to record voice notes and meetings.",
        "NSPhotoLibraryUsageDescription": "Küü lets you attach photos to messages, tasks and pages.",
        "NSCameraUsageDescription": "Küü lets you take photos to attach to messages, tasks and pages.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kuu.app",
      "adaptiveIcon": {
        "backgroundColor": "#FEF6EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEF6EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#131312",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Küü uses the microphone to record voice notes and meetings.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B5461B",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Küü lets you attach photos to messages, tasks and pages.",
          "cameraPermission": "Küü lets you take photos to attach to messages, tasks and pages."
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-video"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
