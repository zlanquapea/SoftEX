{
  "name": "Küü",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "forwardPorts": [5173, 4000],
  "portsAttributes": {
    "5173": { "label": "Küü (open this)", "onAutoForward": "openBrowser" },
    "4000": { "label": "Küü API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm ci && npm run seed",
  "postAttachCommand": {
    "app": "npm run dev"
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
